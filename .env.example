# GPU-сервер
GPU_HOST=user@gpu-server

# LLM (по умолчанию — vLLM на GPU-сервере)
LLM_PROVIDER=vllm
LLM_BASE_URL=http://localhost:8000/v1
# На кластере веса уже лежат локально, качать с Hugging Face не нужно.
LLM_MODEL=/home/jovyan/shares/SR008.fs2/me/models/Qwen3.8-Flash-Next-FP8
LLM_API_KEY=dummy
LLM_CONCURRENCY=64

# vllm serve
# Готовое окружение с vLLM 0.29.0 + torch 2.13.0+cu129; ставить своё не нужно.
VLLM_ENV=/home/jovyan/degainanov/envs/vllm029-cu129
VLLM_PORT=8000
VLLM_TP_SIZE=8
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_MODEL_LEN=32768

# Индекс и поиск
EMBED_MODEL=BAAI/bge-m3
RETRIEVE_TOP_K=40
CHUNK_SECONDS=90
CHUNK_OVERLAP_SECONDS=15

# Транскрибация
WHISPER_MODEL=large-v3
TRANSCRIBE_GPUS=0,1,2,3,4,5,6,7

# Сайт
SITE_BASE=/
GPU_REPO_PATH=~/lecture-exam-prep

# Ответы
LLM_THINKING=false
LLM_TEMPERATURE_EXTRACT=0.0
LLM_TEMPERATURE_SYNTHESIZE=0.3
